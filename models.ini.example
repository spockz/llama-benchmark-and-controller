# Both model sections carry their own inference settings so either preset can
# later be tuned independently without changing the shared router command.
[qwen36-q3-k-m]
hf = unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q3_K_M
ctx-size = 131072
kv-unified-per-slot = 131072
n-gpu-layers = auto
fit = on
fit-target = 512
threads = 6
threads-batch = 6
batch-size = 2048
ubatch-size = 256
flash-attn = on
cache-reuse = 0
no-context-shift = true
kv-unified = true
cache-type-k = q5_1
cache-type-v = q5_1
cache-ram = 8192
temp = 0.6
top-p = 0.95
top-k = 20
reasoning = on
jinja = true
chat-template-kwargs = {"preserve_thinking":false}
slot-save-path = /home/USER/.local/share/llama-modelctl/slots/q3-k-m/

[qwen36-iq4-xs]
hf = unsloth/Qwen3.6-35B-A3B-GGUF:UD-IQ4_XS
ctx-size = 131072
kv-unified-per-slot = 131072
n-gpu-layers = auto
fit = on
fit-target = 256
threads = 8
threads-batch = 8
batch-size = 512
ubatch-size = 512
flash-attn = on
cache-reuse = 0
no-context-shift = true
kv-unified = true
cache-type-k = q5_1
cache-type-v = q5_1
cache-ram = 8192
temp = 0.6
top-p = 0.95
top-k = 20
reasoning = on
jinja = true
chat-template-kwargs = {"preserve_thinking":false}
slot-save-path = /home/USER/.local/share/llama-modelctl/slots/iq4-xs/
